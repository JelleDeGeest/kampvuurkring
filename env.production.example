# Production Environment Variables
# Copy this file to .env.production and fill in your values

# Database Configuration
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=scouts_production
POSTGRES_PORT=5432

# Payload CMS Configuration
PAYLOAD_SECRET=your_payload_secret_key_here
PAYLOAD_PUBLIC_SERVER_URL=https://your-domain.com
NEXT_PUBLIC_SERVER_URL=https://your-domain.com
NEXT_PUBLIC_CLARITY_PROJECT_ID=your-clarity-project-id
CDN_PUBLIC_URL=https://media.your-domain.com

# Draft Mode (for content preview)
PAYLOAD_PUBLIC_DRAFT_SECRET=your_draft_secret_here
NEXT_PUBLIC_DRAFT_SECRET=your_draft_secret_here

# Revalidation (for Next.js ISR)
REVALIDATION_KEY=your_revalidation_key_here
NEXT_PRIVATE_REVALIDATION_KEY=your_private_revalidation_key_here

# Supabase Configuration (if using Supabase features)
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# Port Configuration
PORT=3000
STUDIO_PORT=54323

# Node Environment
NODE_ENV=production 

# Backup Service
RCLONE_REMOTE_PROD=gdrive:kampvuurkring/prod
BACKUP_CRON_PROD=0 2 * * *
BACKUP_RETENTION_DAYS=30
ENABLE_MINIO_BACKUP=true
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKETS=media-original,media-cdn,banner-images,homepage-hero-images,leiders-foto
MINIO_DOMAIN=media.your-domain.com
PG_RESTORE_ROLE=postgres
PG_RESTORE_CLEAN=false
PG_RESTORE_DATA_ONLY=false
PG_RESTORE_SCHEMAS=public
PG_RESTORE_RESET_SCHEMA=true

# S3 / MinIO storage
S3_ENDPOINT=http://minio:9000
S3_ORIGINALS_BUCKET=media-original
S3_CDN_BUCKET=media-cdn
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
